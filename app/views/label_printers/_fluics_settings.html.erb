<%
  # 静态说明文案仍由服务端渲染（无 JS 行为，只用到 Bootstrap 的 collapse data-api）；
  # 两个动态区块（API key 表单 / 打印器列表）由 Vue 3 接管，
  # action / CSRF token 一律服务端生成后注入，保证接口地址与参数名与迁移前完全一致。
  label_printer_urls = {
    create_fluics: create_fluics_label_printers_path,
    csrf_token: form_authenticity_token
  }
  label_printer_printers = @label_printers.map do |printer|
    { id: printer.id, name: printer.name, description: printer.description }
  end
%>
<ul>
  <li>
    <div class="collapse-row">
      <i class="sn-icon sn-icon-down" data-toggle="collapse" href="#fluicsInstructionsSection" aria-expanded="false"></i>
      <div class="row-title"><%= t("users.settings.account.label_printer.instructions") %></div>
    </div>
    <ul class="collapse in collapse-content" id="fluicsInstructionsSection">
      <li>
        <%= t("users.settings.account.label_printer.fluics_instruction.p1") %>
      </li>
      <li>
        <%= t("users.settings.account.label_printer.fluics_instruction.p2_html", link: Constants::SCINOTE_FLUICS_URL) %>
      </li>
      <li>
        <%= t("users.settings.account.label_printer.fluics_instruction.p3") %>
      </li>
      <li>
        <%= t("users.settings.account.label_printer.fluics_instruction.p4") %>
      </li>
      <li>
        <%= t("users.settings.account.label_printer.fluics_instruction.p5") %>
      </li>
    </ul>
  </li>
<% if can_manage_label_printers? %>
  <li id="fluicsSettingsMount">
    <fluics-settings
      :api-key="<%= @fluics_api_key.to_json %>"
      :create-url="<%= label_printer_urls[:create_fluics].to_json %>"
      :csrf-token="<%= label_printer_urls[:csrf_token].to_json %>"
      :flash-error="<%= flash[:error].to_json %>"
    ></fluics-settings>
  </li>
<% end %>
  <li id="fluicsPrintersMount">
    <fluics-printers
      :can-manage="<%= can_manage_label_printers?.to_json %>"
      :api-key="<%= @fluics_api_key.to_json %>"
      :printers="<%= label_printer_printers.to_json %>"
      :create-url="<%= label_printer_urls[:create_fluics].to_json %>"
      :csrf-token="<%= label_printer_urls[:csrf_token].to_json %>"
    ></fluics-printers>
  </li>
</ul>
