<% if login_disclaimer %>
  <% disclaimer_pairs = [
       { button: '.log-in-button', form: '#new_user' },
       { button: '.btn-okta', form: '#oktaForm' },
       { button: '.btn-azure-ad', form: '.azureAdForm' },
       { button: '.btn-openid-connect', form: '#openidConnectForm' },
       { button: '.btn-saml', form: '#samlForm' },
       { button: '.sign-up-button', form: '#sign-up-form' },
       { button: '.forgot-password-submit', form: '#forgot-password-form' },
       { button: '.invitation-submit', form: '#invitation-form' }
     ] %>
  <div id="loginDisclaimerMount">
    <login-disclaimer
      :pairs="<%= disclaimer_pairs.to_json %>"
      :title="<%= login_disclaimer['title'].to_json %>"
      :body="<%= login_disclaimer['body'].to_json %>"
      :action-label="<%= login_disclaimer['action'].to_json %>"
      :cancel-label="<%= t('general.cancel').to_json %>">
    </login-disclaimer>
  </div>
  <%= javascript_include_tag 'vue_login_disclaimer' %>
<% end %>
