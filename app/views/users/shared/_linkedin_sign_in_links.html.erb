<%- if devise_mapping.omniauthable? && resource_class.omniauth_providers.any? %>
  <%= link_to omniauth_authorize_path(resource_name, :linkedin), method: :post, title: "Sign in with LinkedIn", class: 'linkedin-link' do %>
        <span id="linkedinSignInMount">
          <linkedin-sign-in
            :default-src="<%= image_path('linkedin/Sign-in-Large---Default.png').to_json %>"
            :hover-src="<%= image_path('linkedin/Sign-in-Large---Hover.png').to_json %>"
            :click-src="<%= image_path('linkedin/Sign-in-Large---Active.png').to_json %>">
          </linkedin-sign-in>
        </span>
  <% end -%>
  <%= javascript_include_tag 'vue_linkedin_sign_in' %>
<% end -%>
