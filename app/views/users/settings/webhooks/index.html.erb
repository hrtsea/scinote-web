<% provide(:head_title, t('webhooks.index.title')) %>
<% provide(:container_class, "no-second-nav-container") %>

<%
  # 页面数据在服务端组装后一次注入，Vue 只负责渲染与交互；
  # 所有 URL 均由 Rails 路由助手生成，保证接口地址/参数与迁移前完全一致。
  webhook_filters_payload = @activity_filters.map do |filter|
    {
      id: filter.id,
      name: filter.name,
      info_url: filter_info_users_settings_webhooks_path(filter_id: filter.id),
      create_url: users_settings_webhooks_path(filter_id: filter.id, sort: @current_sort),
      webhooks: filter.webhooks.order(created_at: :desc).map do |webhook|
        {
          id: webhook.id,
          http_method: webhook.http_method,
          url: webhook.url,
          active: webhook.active?,
          include_serialized_subject: webhook.include_serialized_subject,
          secret_key: webhook.secret_key,
          update_url: users_settings_webhook_path(webhook, filter_id: filter.id, sort: @current_sort),
          enable_url: users_settings_webhook_path(webhook, filter_id: filter.id, 'webhook[active]' => true, sort: @current_sort),
          disable_url: users_settings_webhook_path(webhook, filter_id: filter.id, 'webhook[active]' => false, sort: @current_sort),
          delete_url: users_settings_webhook_path(webhook, filter_id: filter.id, sort: @current_sort)
        }
      end
    }
  end

  webhook_urls_payload = { destroy_filter: destroy_filter_users_settings_webhooks_path(sort: @current_sort) }
  webhook_methods_payload = Webhook.http_methods.keys.map { |key| { value: key, label: key.upcase } }
%>

<%= render partial: "users/settings/sidebar" %>

<div class="content-pane flexible webhooks-index">
  <div class="content-header sticky-header">
    <div class="title-row">
      <h1>
        <%= t('webhooks.index.title') %>
      </h1>
      <div class="header-actions">
        <div class="dropdown sort-menu" title="<%= t("general.sort.title") %>">
          <button class="btn btn-light btn-black icon-btn dropdown-toggle" type="button" id="sortMenu" data-toggle="dropdown" aria-haspopup="true" aria-expanded="true">
            <span><i class="sn-icon sn-icon-sort-down"></i></span>
          </button>
          <ul id="sortMenuDropdown" class="dropdown-menu dropdown-menu-right" aria-labelledby="sortMenu">
            <% %w(atoz ztoa).each do |sort| %>
              <li>
                <%= link_to t("general.sort.#{sort}_html"), users_settings_webhooks_path(sort: sort), class: (@current_sort == sort ? 'selected' : '') %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
    </div>
  </div>
  <div class="webhooks-description">
    <%= t('webhooks.index.description') %>
  </div>

  <div id="webhooksIndex">
    <webhooks-index
      :filters="<%= webhook_filters_payload.to_json %>"
      :urls="<%= webhook_urls_payload.to_json %>"
      :method-options="<%= webhook_methods_payload.to_json %>"
    ></webhooks-index>
  </div>
</div>

<%= javascript_include_tag 'vue_webhooks' %>
