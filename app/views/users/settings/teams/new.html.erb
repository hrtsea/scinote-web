<% provide(:head_title, t("users.settings.teams.head_title")) %>
<% provide(:container_class, "no-second-nav-container") %>

<%= render partial: "users/settings/sidebar" %>
<div class="tab-content">
  <div class="tab-pane content-pane" role="tabpanel"></div>
  <div class="tab-pane content-pane active" role="tabpanel">
    <div id="new-team-form-vue">
      <new-team-form
        :action-url="<%= create_team_path.to_json %>"
        :cancel-url="<%= teams_path.to_json %>"
        :csrf-token="<%= form_authenticity_token.to_json %>"
        :name-value="<%= @new_team.name.to_json %>"
        :description-value="<%= @new_team.description.to_json %>"
        :labels="<%= {
          nameLabel: t('users.settings.teams.new.name_label'),
          namePlaceholder: t('users.settings.teams.new.name_placeholder'),
          nameSublabel: t('users.settings.teams.new.name_sublabel'),
          descriptionLabel: t('users.settings.teams.new.description_label'),
          descriptionSublabel: t('users.settings.teams.new.description_sublabel'),
          cancel: t('general.cancel'),
          create: t('users.settings.teams.new.create')
        }.to_json %>"
      />
    </div>
  </div>
</div>

<%= javascript_include_tag 'vue_team_new' %>
<span data-hook="team-new-bottom"></span>
