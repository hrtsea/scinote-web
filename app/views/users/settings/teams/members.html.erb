<% provide(:head_title, t("users.settings.teams.head_title")) %>
<% provide(:container_class, "no-second-nav-container") %>

<% content_for :head do %>
  <meta id="cache-directive" name="turbolinks-cache-control" content="no-cache">
<% end %>

<div class="content-pane flexible team-settings-pane with-grey-background">
  <%= render partial: 'header' %>

  <!-- USERS TABLE -->
  <div id="teamMembersTableMount">
    <team-members-table
      :data-source="<%= team_users_datatable_path(@team, format: :json).to_json %>"
      :can-invite="<%= can_invite_team_users?(@team).to_json %>"
    ></team-members-table>
  </div>
  <!-- End of USERS TABLE -->

  <!-- Delete workspace (visible to team owners and system admins) -->
  <% if can_manage_team?(@team) || (current_user.respond_to?(:system_admin?) && current_user.system_admin?) %>
    <div class="flex justify-end py-3">
      <button type="button" class="btn btn-danger" data-toggle="modal" data-target="#modal-destroy-team" data-e2e="e2e-BT-workspaceSettings-deleteWorkspace">
        <span class="sn-icon sn-icon-delete"></span>
        <%= t("users.settings.teams.edit.delete_team_heading") %>
      </button>
    </div>
  <% end %>
</div>

<%# The invite modal is rendered server-side and wired by the global `invite_users_modal.js`
    (loaded via application.js). It is kept as static markup so Bootstrap/open behaviour is
    unchanged. %>
<% if can_invite_team_users?(@team) %>
  <%= render(partial: 'shared/invite_users_modal',
              locals: { modal_id: 'team-invite-users-modal',
                        type: 'invite_to_team_with_role',
                        team: @team } ) %>
<% end %>

<%= render partial: 'users/settings/teams/description_modal' %>
<%= render partial: 'users/settings/teams/destroy_modal', locals: { team: @team } %>
<%= render partial: 'users/settings/user_teams/destroy_user_team_modal' %>
<%= stylesheet_link_tag 'datatables' %>
<%= javascript_include_tag 'vue_team_members' %>
<span data-hook="team-bottom"></span>
