<!doctype html>
<html>
  <head>
    <meta charset="utf-8">
    <meta http-equiv="x-ua-compatible" content="ie=edge">
    <title><%= t('assets.head_title.view', file_name: @asset.file_name) %></title>
    <meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no">
    <style type="text/css">
      body { margin: 0; padding: 0; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; background: #f4f6f8; color: #1f2933; }
      .unsupported-wrap { max-width: 640px; margin: 12vh auto; padding: 28px 32px; background: #fff; border-radius: 10px; box-shadow: 0 1px 6px rgba(0,0,0,.08); }
      .unsupported-wrap h3 { margin: 0 0 8px; font-size: 18px; word-break: break-all; }
      .unsupported-wrap p { margin: 0 0 18px; line-height: 1.6; color: #52606d; }
      .unsupported-wrap a.btn { display: inline-block; padding: 9px 18px; background: #2563eb; color: #fff; text-decoration: none; border-radius: 5px; font-weight: 600; }
      .unsupported-wrap a.btn:hover { background: #1d4ed8; }
    </style>
  </head>
  <body>
    <div class="unsupported-wrap">
      <h3><%= @asset.file_name %></h3>
      <p><%= t('assets.wopi_unavailable', default: '在线查看 / 编辑（Office Online / WOPI）在当前环境未启用，因此无法在浏览器内打开此文件。你可以直接下载文件后本地查看或编辑。') %></p>
      <a class="btn" href="<%= rails_blob_path(@asset.file, disposition: 'attachment') %>"><%= t('assets.download', default: '下载文件') %></a>
    </div>
  </body>
</html>
