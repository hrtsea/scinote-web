# SciNote 功能开关相关环境变量示例
#
# 复制为 .env 后按需填写。以下变量为「留空即关闭」的开关。
# 其余功能开关（库存管理、表单、存储位置、用户组、协议锁定、设备预约等）
# 由数据库 ApplicationSettings 控制，已通过迁移
# db/migrate/20260830120000_enable_feature_flags.rb 开启，无需在此配置。

# protocols.io 导入（protocols_io_enabled?）：需真实的 protocols.io API 令牌
PROTOCOLS_IO_ACCESS_TOKEN=

# AI 协议解析服务（ai_parser_enabled?）：需解析服务地址；
# 同时需在 ApplicationSettings 中开启 ai_protocol_parser_enabled（迁移已置 true）
AI_PROTOCOLS_PARSER=

# ===== 以下为布尔型功能开关，留空(或设为 false)即关闭，设为 true 即开启 =====

# 定时任务调度（提醒/同步/清理）；其下两项需本项先开启
SCINOTE_SCHEDULER_ENABLED=true
# 模板项目同步
ENABLE_TEMPLATES_SYNC=true
# Fluics 标签模板同步
ENABLE_FLUICS_SYNC=true
# PDF 预览（需容器内已安装 poppler 等依赖）
ACTIVESTORAGE_ENABLE_PDF_PREVIEWS=true
# Active Storage vips 处理器
ACTIVESTORAGE_ENABLE_VIPS=true
# Core API v1 / v2 路由门控
CORE_API_V1_ENABLED=true
CORE_API_V2_ENABLED=true
# Core API Key 认证
CORE_API_KEY_ENABLED=true

# PWA 跨域（CORS）：填 PWA 站点的真实来源（如 https://pwa.example.com）；留空则关闭
SCINOTE_PWA_DOMAIN_NAME=https://pwa.example.com
