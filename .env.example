# SciNote 功能开关相关环境变量示例
#
# 复制为 .env 后按需填写。以下变量为「留空即关闭」的开关。
# 其余功能开关（库存管理、表单、存储位置、用户组、协议锁定、设备预约等）
# 由数据库 ApplicationSettings 控制，已通过迁移
# db/migrate/20260830120000_enable_feature_flags.rb 开启，无需在此配置。

# protocols.io 导入（protocols_io_enabled?）：需真实的 protocols.io API 令牌
PROTOCOLS_IO_ACCESS_TOKEN=

# AI 协议解析服务（ai_parser_enabled?）：需解析服务地址；
# 同时需在 ApplicationSettings 中开启 ai_protocol_parser_enabled（迁移已置 true）
AI_PROTOCOLS_PARSER=
