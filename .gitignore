# See https://help.github.com/articles/ignoring-files for more about ignoring files.
#
# If you find yourself ignoring temporary files generated by your text editor
# or operating system, you probably want to add a global ignore instead:
#   git config --global core.excludesfile '~/.gitignore_global'

# Ignore bundler config.
/.bundle

# Ignore addons

# /addons

# Ignore the default SQLite database.
/db/*.sqlite3
/db/*.sqlite3-journal

# Ignore PostgreSQL dump files
/db/*.dump

# Ignore all logfiles and tempfiles.
/log/*
!/log/.keep
/tmp

# Ignore gems etc. if built in bundle
/vendor/bundle

# Ignore vendored build caches (reproducible, generated by host scripts):
# - vendor/cache: pre-downloaded .gem files for `bundle install --local`
# - vendor/git-mirror: local mirrors of git-source gems (canaid/caracal/img2zpl/omniauth-okta/tui.image-editor)
/vendor/cache
/vendor/git-mirror

# Ignore custom wmake user file
wmake.sh

# Windows image file caches
Thumbs.db
ehthumbs.db

# Byebug temp file
/.byebug_history

# Ignore temporary files
public/system/*

# Ignore BioEddie installion in public folder
public/bio_eddie/

# Ignore ActiveStorage Disc service storage directory
storage/

$ Ignore compiled assets
public/packs-test/*

*.orig
*.swp
*.out
*.db

# Ignore application configuration
/config/application.yml
/production.env

# Ignore rubocop cache files
rubocop_cache

# Ignore ESLint local instalation
node_modules

# Ignore Coverage output
coverage

# Added during webpacker install
/public/packs
/node_modules
.DS_Store
app/javascript/src/componentLoader/components/*

# ignore addon features
features/addons
spec/addons
!features/addons/.gitkeep
!spec/addons/.gitkeep

# RVM/rbenv ruby version for local development
.ruby-version

# Ignore marvinJs

public/marvinjs
public/marvin4js-license.cxl

# Ignore JetBrains
.idea/

/app/assets/builds/*
!/app/assets/builds/.keep

# Ignore automatically generated js-routes files.
/app/javascript/routes.js
/app/javascript/routes.d.ts

# Ignore generated reports PDF icons
/app/assets/stylesheets/reports_pdf_icons.sass.scss

./yarn

# 本地构建/数据库导出/临时产物（本地生成，不入版本库）
/*.log
/*.sql
/.container_*
/tmp_*.sh
/tmp_*.rb

# 孤儿代码：elncp/ 是被 addons/eln_ui 取代的旧版项目列表控制器，
# 其路由 eln_project_list_v1 已标注「孤儿 V1 项目列表，不接生产路径」。
# 保留在工作区作迁移参考，不入版本库，避免与 eln_ui 双源并存。
/elncp/

# 注：.scratch/ 不忽略 —— 按 AGENTS.md 约定它是 issue/spec 的正式真源
# （one dir per feature, tickets under issues/），已有 49 个文件在库内。

# 本地 E2E 冒烟脚本与失败现场截图（验收工具，非交付物）
/e2e/