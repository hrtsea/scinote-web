<%# ELN UI —— 项目列表页（V2.0，接入原生 AG Grid 栈 shared/datatable）
    § 挂载契约：
      1. #eln-project-list 是唯一挂载点，对应
         eln_ui/app/javascript/vue/eln_project_list/list.vue。
      2. 数据由 list.vue 经 DataTable 异步拉取 /eln_project_list/grid（JSON:API 形状），
         不再依赖页面内联 JSON 数据块（旧 V1 的 #eln-project-list-data / window.__ELN_PROJECT_LIST__ 已废弃）。
      3. 多列钉住 / 列重排 / 显隐 / 状态记忆 全部由 shared/datatable 原生支持，
         并自动持久化到 user_settings（stateKey = `eln_project_list_active_table_state`）。
      4. 生产 CSP 的 script-src 为 'self' + nonce：挂载脚本必须带 nonce，否则点击无反应。
      5. 样式（ADR-0038-D）：由 webpack entry 抽取的 eln_project_list.css 承载
         —— 真源 addons/eln_ui/.../eln_project_list/styles/eln_project_list.scss
         （AG Grid 主题覆盖，scoped 到 #eln-project-list）。旧原型 blob
         eln_vue3/eln_project_list.css 已退休，不再加载。
%>
<% provide(:head_title, '项目') %>

<%# addon 视图默认不输出 CSRF meta；新建/新建文件夹等 POST 端点需要它，
   原生 custom_axios 会读取页面 csrf-token meta 注入请求头。 %>
<%= tag.meta name: 'csrf-token', content: form_authenticity_token %>
<%# AG Grid 主题覆盖（webpack 产物，见 pack 里 import 的 scss）。
    ⚠ 扩展名可省（Sprockets 解析 eln_project_list.css），但必须已登记进 manifest，
      否则生产 assets.compile=false 下 AssetNotFound → 整页 500。 %>
<%= stylesheet_link_tag 'eln_project_list', media: 'all' %>
<%# 高度链：shared/datatable 根元素为 h-full，宿主必须提供高度
    （对齐原生 /projects 的 content-pane.flexible > .fixed-content-body 结构），
    否则 AG Grid 以 0 高度渲染 —— 表格在 DOM 里存在但视觉上整片空白。 %>
<div class="content-pane flexible">
  <div id="eln-project-list" class="fixed-content-body"></div>
</div>
<%# 扩展名不能省：SciNote 的 sprockets 走 precompile 名单精确匹配，
    不带 .js 会直接 AssetNotFound → 整页 500。 %>
<%= javascript_include_tag 'eln_project_list', nonce: content_security_policy_nonce %>
