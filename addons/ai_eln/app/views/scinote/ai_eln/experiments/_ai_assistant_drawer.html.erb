<%# AI 助手抽屉（ai_eln 引擎，ActiveAgent 实现）。参数化以支持多实体 / 全局复用：
#   locals:
#     id:          抽屉 DOM id（默认 'aiAssistantDrawer'；全局注入须用不同 id 避免与实体抽屉冲突）
#     title:       标题（默认 'AI 助手'）
#     input_label: 可选查询输入框标签；提供时渲染文本框，点击 action 按钮将其值以 { query: } 发送
#     actions:     [{ label:, url: }] 按钮列表
# 上下文由调用方经 actions[].url 注入；本局部不读取 @experiment/@protocol/@asset。
%>
<%
  drawer_id   = local_assigns[:id] || 'aiAssistantDrawer'
  title       = local_assigns[:title] || 'AI 助手'
  input_label = local_assigns[:input_label]
  actions     = local_assigns[:actions] || []
%>
<div class="offcanvas offcanvas-end" tabindex="-1" id="<%= drawer_id %>"
     aria-labelledby="<%= drawer_id %>Label">
  <div class="offcanvas-header">
    <h5 class="offcanvas-title" id="<%= drawer_id %>Label"><%= title %></h5>
    <button type="button" class="btn-close text-reset" data-bs-dismiss="offcanvas" aria-label="关闭"></button>
  </div>
  <div class="offcanvas-body">
    <p class="text-muted small">
      基于当前上下文调用 AI。注意：数据将发送至云端 DeepSeek，
      仅用于开发期 / 非敏感（合成）数据验证。
    </p>
    <% if input_label %>
      <div class="mb-3">
        <label for="<%= drawer_id %>Query" class="form-label small"><%= input_label %></label>
        <textarea class="form-control" id="<%= drawer_id %>Query" rows="2"
                  placeholder="输入检索词…"></textarea>
      </div>
    <% end %>
    <% actions.each do |action| %>
      <button class="btn btn-primary w-100 mb-2 ai-action-btn" type="button"
              data-action-url="<%= action[:url] %>"><%= action[:label] %></button>
    <% end %>
    <hr>
    <div class="d-none text-center mt-3" id="<%= drawer_id %>Spinner">
      <div class="spinner-border" role="status"><span class="visually-hidden">加载中…</span></div>
    </div>
    <div id="<%= drawer_id %>Result" class="mt-3" style="white-space: pre-wrap;"></div>
  </div>
</div>

<%= javascript_tag do %>
  (function () {
    var drawer = document.getElementById('<%= drawer_id %>');
    if (!drawer) return;
    var resultEl = document.getElementById('<%= drawer_id %>Result');
    var spinner = document.getElementById('<%= drawer_id %>Spinner');
    var queryEl = document.getElementById('<%= drawer_id %>Query');
    var csrf = document.querySelector('meta[name="csrf-token"]');

    drawer.querySelectorAll('.ai-action-btn').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var url = btn.getAttribute('data-action-url');
        var payload = {};
        if (queryEl) { payload.query = queryEl.value; }
        resultEl.textContent = '';
        spinner.classList.remove('d-none');
        btn.disabled = true;

        fetch(url, {
          method: 'POST',
          headers: {
            'X-CSRF-Token': csrf ? csrf.getAttribute('content') : '',
            'Accept': 'application/json',
            'Content-Type': 'application/json'
          },
          body: JSON.stringify(payload)
        })
          .then(function (r) {
            return r.json().then(function (d) { return { ok: r.ok, data: d }; });
          })
          .then(function (res) {
            spinner.classList.add('d-none');
            btn.disabled = false;
            if (res.ok && res.data.summary) {
              resultEl.textContent = res.data.summary;
            } else if (res.ok && res.data.result) {
              resultEl.textContent = res.data.result;
            } else {
              resultEl.textContent = '错误：' + (res.data.error || '未知错误');
            }
          })
          .catch(function (e) {
            spinner.classList.add('d-none');
            btn.disabled = false;
            resultEl.textContent = '请求失败：' + e.message;
          });
      });
    });
  })();
<% end %>
