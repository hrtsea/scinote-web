<%# 状态概览 Widget（P4）：echarts 饼图挂载点；JS 经 content_for(:head) 注入 dashboard <head>。
    对齐 frame_014 官方 UI：环形图中心显示任务总数（"Tasks / 73"），
    总数由 JS 依聚合结果求和后写入（data-total-label 提供本地化标签）。 %>
<% if Scinote::ProjectInsights.enabled? && !content_for?(:insights_charts_head) %>
  <% content_for(:head) { javascript_include_tag 'insights_charts' } %>
  <% content_for(:insights_charts_head, '') %>
<% end %>
<div class="project-insights-widget basic-widget <%= widget[:size] %>" style="order: <%= widget[:position] %>">
  <div class="widget-header">
    <div class="widget-title"><%= t('dashboard.insights.status.title') %></div>
  </div>
  <div class="widget-content">
    <div data-insights-chart="pie"
         data-ajax-url="<%= Scinote::ProjectInsights::Engine.routes.url_helpers.insights_path(kind: 'status', project_id: local_assigns[:project_id]) %>"
         data-drilldown-base="<%= dashboard_current_tasks_path %>"
         data-total-label="<%= t('dashboard.insights.status.total_label') %>"
         style="width: 100%; height: 280px;"></div>
  </div>
</div>
