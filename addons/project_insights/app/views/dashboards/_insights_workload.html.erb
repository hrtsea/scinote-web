<%# 团队负载分布 Widget（P5）：echarts 堆叠柱图挂载点；JS 经 content_for(:head) 注入 dashboard <head>。
    对齐 frame_014 官方 UI：标题右侧展示成员筛选计数 "N options selected"，
    由 JS 依聚合结果的 distinct 用户数填充（data-user-count-template 提供本地化模板）。 %>
<% if Scinote::ProjectInsights.enabled? && !content_for?(:insights_charts_head) %>
  <% content_for(:head) { javascript_include_tag 'insights_charts' } %>
  <% content_for(:insights_charts_head, '') %>
<% end %>
<div class="project-insights-widget basic-widget <%= widget[:size] %>" style="order: <%= widget[:position] %>">
  <div class="widget-header">
    <div class="widget-title"><%= t('dashboard.insights.workload.title') %></div>
    <span class="insights-user-filter"
          data-user-count-template="<%= t('dashboard.insights.workload.options_selected', count: '%{count}') %>">–</span>
  </div>
  <div class="widget-content">
    <div data-insights-chart="bar"
         data-ajax-url="<%= Scinote::ProjectInsights::Engine.routes.url_helpers.insights_path(kind: 'workload', project_id: local_assigns[:project_id]) %>"
         data-drilldown-base="<%= dashboard_current_tasks_path %>"
         style="width: 100%; height: 300px;"></div>
    <%# D 可交互成员多选：JS 依负载数据填充成员勾选框；取消勾选即按所选成员重绘柱图。 %>
    <div class="member-filter" data-member-filter hidden>
      <span class="member-filter-title"><%= t('dashboard.insights.workload.member_filter') %></span>
      <div class="member-filter-items" data-member-filter-items></div>
    </div>
  </div>
</div>
